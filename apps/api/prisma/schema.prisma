generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  importFileExtension = ""
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           BigInt    @id @default(autoincrement())
  uid          String    @unique @db.Uuid
  email        String    @unique @db.VarChar(255)
  nickname     String    @db.VarChar(100)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  friendCode   String    @unique @map("friend_code") @db.Char(8)

  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(3)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  sentFriendRequests     Friendship[] @relation("FriendshipRequester")
  receivedFriendRequests Friendship[] @relation("FriendshipReceiver")
  chatRoomMembers ChatRoomMember[]

  @@map("users")
}

model Friendship {
  id  BigInt @id @default(autoincrement())
  uid String @unique @db.Uuid

  requesterId BigInt @map("requester_id")
  receiverId  BigInt @map("receiver_id")

  status Int @default(0) @db.SmallInt

  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(3)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id])
  receiver  User @relation("FriendshipReceiver", fields: [receiverId], references: [id])

  @@unique([requesterId, receiverId])
  @@index([requesterId])
  @@index([receiverId])
  @@index([status])
  @@map("friendships")
}

model ChatRoom {
  id        BigInt   @id @default(autoincrement())
  uid       String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members ChatRoomMember[]

  @@map("chat_rooms")
}

model ChatRoomMember {
  id         BigInt   @id @default(autoincrement())
  chatRoomId BigInt
  userId     BigInt
  joinedAt   DateTime @default(now())
  lastReadMessageId String?   @db.VarChar(24)
  lastReadAt        DateTime?

  chatRoom ChatRoom @relation(fields: [chatRoomId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([chatRoomId, userId])
  @@index([userId])
  @@map("chat_room_members")
}