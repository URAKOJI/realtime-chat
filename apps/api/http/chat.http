@baseUrl = http://localhost:3001
@email = test@example.com
@password = password123!
@friendUid = 01a00b08-48d1-729c-bb06-0665597bf412
@chatRoomUid = 01a00e60-6ce8-70ac-8e58-d95544703e31


### 로그인
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}


### 내 정보 확인
GET {{baseUrl}}/users/me


### 채팅방 생성
# @name createChatRoom
POST {{baseUrl}}/chat-rooms
Content-Type: application/json

{
  "friendUid": "{{friendUid}}"
}


### 채팅방 목록 조회
GET {{baseUrl}}/chat-rooms


### 생성된 채팅방의 이전 메시지 조회
GET {{baseUrl}}/chat-rooms/{{chatRoomUid}}/messages


### 존재하지 않는 채팅방 조회 - 404 확인
GET {{baseUrl}}/chat-rooms/not-exist-room/messages


### 친구가 아닌 사용자로 채팅방 생성 - 403 확인
POST {{baseUrl}}/chat-rooms
Content-Type: application/json

{
  "friendUid": "01a00b08-48d1-729c-bb06-0665597bf411"
}


### 자기 자신과 채팅방 생성 - 403 확인
POST {{baseUrl}}/chat-rooms
Content-Type: application/json

{
  "friendUid": "01a005d0-1cee-72ec-a333-4e57e57a05c7"
}